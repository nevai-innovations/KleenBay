generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EMPLOYEE
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  MUV
  TWO_WHEELER
  COMMERCIAL
  OTHER
}

enum JobStage {
  RECEIVED
  WASHING
  READY
  HANDED_OVER
}

enum MessageEvent {
  VEHICLE_RECEIVED
  WASH_STARTED
  VEHICLE_READY
  VEHICLE_HANDED_OVER
}

enum MessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum MessageProviderType {
  MOCK
  MSG91
}

enum WhatsAppConnectionStatus {
  MOCK_ACTIVE
  NOT_CONNECTED
  PENDING_VERIFICATION
  CONNECTED
  ERROR
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum SubscriptionStatus {
  INACTIVE
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  PAYMENT_FAILED
}

enum SubscriptionPaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceItemKind {
  SERVICE
  ADD_ON
  PRODUCT
  CUSTOM
}

enum DiscountKind {
  NONE
  FLAT
  PERCENT
}

enum PhotoKind {
  BEFORE
  DURING
  AFTER
  DAMAGE
}

enum InspectionLocation {
  FRONT
  REAR
  LEFT
  RIGHT
  INTERIOR
  WINDSHIELD
  WHEELS
  OTHER
}

enum DamageType {
  SCRATCH
  DENT
  CRACK
  PAINT_DAMAGE
  BROKEN_ITEM
  INTERIOR_DAMAGE
  OTHER
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  currency      String    @default("INR")
  timezone      String    @default("Asia/Kolkata")
  nextJobNumber Int       @default(1)
  nextInvoiceNumber Int   @default(1)
  invoicePrefix String    @default("KB")
  gstRateBps Int?
  gstin String?
  invoiceAddress String?
  invoicePhone String?
  allowCustomInvoiceItems Boolean @default(false)
  employeeAddons Boolean @default(false)
  allowOutstanding Boolean @default(true)
  employeeHandover Boolean @default(true)
  sendHandoverMessage Boolean @default(false)
  showCustomerTrackingLink Boolean @default(true)
  showCompletedVehiclePhotos Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  branches      Branch[]
  users         User[]
  sessions      Session[]
  otpChallenges OtpChallenge[]
  ownerSetups   OwnerSetup[]
  auditLogs     AuditLog[]
  customers     Customer[]
  vehicles      Vehicle[]
  services      Service[]
  servicePrices ServicePrice[]
  serviceBranches ServiceBranch[]
  jobs          Job[]
  jobStageHistory JobStageHistory[]
  jobAssignments JobAssignment[]
  messages      Message[]
  messageAttempts MessageAttempt[]
  whatsAppConfig OrganizationWhatsAppConfig?
  invoices      Invoice[]
  invoiceItems InvoiceItem[]
  saleItems SaleItem[]
  payments      Payment[]
  inspections   VehicleInspection[]
  damageItems   InspectionDamageItem[]
  photos        Photo[]
  subscription  Subscription?
  subscriptionPayments SubscriptionPayment[]
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  planCode           String             @default("KLEENBAY_ANNUAL")
  status             SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  activatedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id])
  payments           SubscriptionPayment[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model SubscriptionPayment {
  id                    String                    @id @default(cuid())
  organizationId        String
  subscriptionId        String
  provider              String                    @default("RAZORPAY")
  razorpayOrderId       String?                   @unique
  razorpayPaymentId     String?                   @unique
  checkoutKey           String?
  merchantTransactionId String                    @unique
  providerTransactionId String?                   @unique
  amountPaise           Int
  currency              String                    @default("INR")
  status                SubscriptionPaymentStatus @default(INITIATED)
  initiatedAt           DateTime                  @default(now())
  completedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  providerStatus        String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  organization          Organization              @relation(fields: [organizationId], references: [id])
  subscription          Subscription              @relation(fields: [subscriptionId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([organizationId, checkoutKey])
  @@index([organizationId, initiatedAt])
  @@index([organizationId, status])
  @@index([subscriptionId, organizationId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String?
  address        String?
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String       @default("IN")
  timezone       String       @default("Asia/Kolkata")
  openingTime    String?
  closingTime    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  servicePrices  ServicePrice[]
  serviceBranches ServiceBranch[]
  jobs           Job[]
  messages       Message[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model User {
  id             String           @id @default(cuid())
  organizationId String
  branchId       String?
  role           Role
  name           String
  username       String?
  email          String?          @unique
  passwordHash   String?
  active         Boolean          @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  branch         Branch?          @relation(fields: [branchId, organizationId], references: [id, organizationId])
  employee       EmployeeProfile?
  sessions       Session[]
  otpChallenges  OtpChallenge[]
  ownerSetup     OwnerSetup?
  auditLogs      AuditLog[]
  checkedInJobs  Job[]             @relation("CheckedInBy")
  handedOverJobs Job[]             @relation("HandedOverBy")
  stageUpdates   JobStageHistory[]
  assignments    JobAssignment[]  @relation("AssignedEmployee")
  assignedJobs   JobAssignment[]  @relation("AssignedBy")
  collectedPayments Payment[]
  inspections    VehicleInspection[]
  photos         Photo[]

  @@unique([id, organizationId])
  @@unique([organizationId, username])
  @@unique([organizationId, email])
  // The one-OWNER-per-organization partial unique index is maintained by migration.
  @@index([organizationId, role, active])
}

model EmployeeProfile {
  userId         String   @id
  organizationId String
  mobile         String   @unique
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId, organizationId], references: [id, organizationId])

  @@unique([userId, organizationId])
  @@unique([organizationId, mobile])
  @@index([organizationId, mobile])
}

model Session {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId, organizationId], references: [id, organizationId])

  @@index([organizationId, userId, expiresAt])
}

model OtpChallenge {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  codeHash       String
  requestSourceHash String?
  providerTokenHash String? @unique
  maxAttempts    Int          @default(5)
  expiresAt      DateTime
  attempts       Int          @default(0)
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId, organizationId], references: [id, organizationId])

  @@index([organizationId, userId, createdAt])
  @@index([requestSourceHash, createdAt])
}

model OwnerSetup {
  id             String       @id @default(cuid())
  organizationId String
  userId         String       @unique
  tokenHash      String       @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId, organizationId], references: [id, organizationId])

  @@unique([userId, organizationId])
  @@index([organizationId, expiresAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorUserId, organizationId], references: [id, organizationId])

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model Customer {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  mobile          String
  alternateMobile String?
  email           String?
  notes           String?
  tags            String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  vehicles        Vehicle[]
  jobs            Job[]
  messages        Message[]

  @@unique([id, organizationId])
  @@unique([organizationId, mobile])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
}

model Vehicle {
  id                 String       @id @default(cuid())
  organizationId     String
  customerId         String
  registrationNumber String
  make               String
  model              String
  variant            String?
  type               VehicleType
  colour             String?
  year               Int?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id])
  customer           Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId])
  jobs               Job[]

  @@unique([id, organizationId])
  @@unique([organizationId, registrationNumber])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt])
}

model Service {
  id                String         @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  category          String
  basePricePaise    Int
  estimatedMinutes  Int
  taxRateBps        Int            @default(0)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id])
  prices            ServicePrice[]
  branches          ServiceBranch[]
  jobs              Job[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model ServicePrice {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String
  branchId       String?
  vehicleType    VehicleType
  pricePaise     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  service        Service      @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  branch         Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([serviceId, vehicleType, branchId])
  @@index([organizationId, branchId, vehicleType])
}

model ServiceBranch {
  id             String       @id @default(cuid())
  organizationId String
  serviceId      String
  branchId       String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  service        Service      @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  branch         Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId])

  @@unique([serviceId, branchId])
  @@index([organizationId, branchId, active])
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String
  customerId     String
  vehicleId      String
  serviceId      String
  number         Int
  idempotencyKey String
  serviceName    String
  servicePricePaise Int @default(0)
  serviceTaxRateBps Int @default(0)
  subtotalPaise  Int
  taxPaise       Int
  totalPaise     Int
  status         JobStage     @default(RECEIVED)
  checkedInAt    DateTime     @default(now())
  checkedInById  String
  stageAt        DateTime     @default(now())
  expectedAt     DateTime
  notes          String?
  notify         Boolean      @default(true)
  handedOverAt   DateTime?
  handedOverById String?
  handoverNotes  String?
  trackingTokenHash String? @unique
  trackingTokenCiphertext String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  branch         Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId])
  customer       Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId])
  vehicle        Vehicle      @relation(fields: [vehicleId, organizationId], references: [id, organizationId])
  service        Service      @relation(fields: [serviceId, organizationId], references: [id, organizationId])
  checkedInBy    User         @relation("CheckedInBy", fields: [checkedInById, organizationId], references: [id, organizationId])
  handedOverBy   User?        @relation("HandedOverBy", fields: [handedOverById, organizationId], references: [id, organizationId])
  stages         JobStageHistory[]
  assignments    JobAssignment[]
  messages       Message[]
  invoices       Invoice[]
  inspection     VehicleInspection?
  photos         Photo[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchId, status])
  @@index([organizationId, checkedInAt])
  @@index([organizationId, handedOverAt])
  @@index([organizationId, vehicleId, checkedInAt])
}

model JobStageHistory {
  id             String       @id @default(cuid())
  organizationId String
  jobId          String
  fromStage      JobStage?
  toStage        JobStage
  actorUserId    String
  note           String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  job            Job          @relation(fields: [jobId, organizationId], references: [id, organizationId])
  actor          User         @relation(fields: [actorUserId, organizationId], references: [id, organizationId])

  @@index([organizationId, jobId, createdAt])
  @@index([organizationId, createdAt])
}

model JobAssignment {
  id             String       @id @default(cuid())
  organizationId String
  jobId          String
  employeeId     String
  assignedById   String
  role           String?
  assignedAt     DateTime     @default(now())
  removedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  job            Job          @relation(fields: [jobId, organizationId], references: [id, organizationId])
  employee       User         @relation("AssignedEmployee", fields: [employeeId, organizationId], references: [id, organizationId])
  assignedBy     User         @relation("AssignedBy", fields: [assignedById, organizationId], references: [id, organizationId])

  @@index([organizationId, jobId, removedAt])
  @@index([organizationId, employeeId, assignedAt])
}

model Message {
  id                String        @id @default(cuid())
  organizationId    String
  branchId          String
  jobId             String
  customerId        String
  event             MessageEvent
  templateKey       String
  recipient         String
  renderedText      String
  templateVariables Json?
  provider          MessageProviderType
  senderNumber      String?
  senderDisplayName String?
  trackingTokenHash String?
  status            MessageStatus @default(PENDING)
  attempts          Int           @default(0)
  providerMessageId String?
  sentAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  nextRetryAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization  @relation(fields: [organizationId], references: [id])
  branch            Branch        @relation(fields: [branchId, organizationId], references: [id, organizationId])
  job               Job           @relation(fields: [jobId, organizationId], references: [id, organizationId])
  customer          Customer      @relation(fields: [customerId, organizationId], references: [id, organizationId])
  deliveryAttempts  MessageAttempt[]

  @@unique([jobId, event])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, branchId, createdAt])
}

model OrganizationWhatsAppConfig {
  organizationId String @id
  provider MessageProviderType @default(MOCK)
  enabled Boolean @default(true)
  senderNumber String?
  senderDisplayName String?
  msg91IntegratedNumberId String?
  credentialRef String?
  templateReceived String @default("VEHICLE_RECEIVED")
  templateWashing String @default("WASH_STARTED")
  templateReady String @default("VEHICLE_READY")
  templateHandedOver String? @default("VEHICLE_HANDED_OVER")
  status WhatsAppConnectionStatus @default(MOCK_ACTIVE)
  mockFailNext Boolean @default(false)
  lastVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id])
}

model MessageAttempt {
  id             String       @id @default(cuid())
  organizationId String
  messageId      String
  number         Int
  status         MessageStatus
  failureReason  String?
  providerMessageId String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  message        Message      @relation(fields: [messageId, organizationId], references: [id, organizationId])

  @@unique([messageId, number])
  @@index([organizationId, messageId, createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  jobId          String
  invoiceNumber  String
  subtotalPaise  Int
  discountKind   DiscountKind  @default(NONE)
  discountValue  Int           @default(0)
  discountPaise  Int           @default(0)
  taxablePaise   Int           @default(0)
  taxPaise       Int
  totalPaise     Int
  status         InvoiceStatus @default(DRAFT)
  issuedAt       DateTime?
  cancelledAt    DateTime?
  replacesInvoiceId String?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  job            Job           @relation(fields: [jobId, organizationId], references: [id, organizationId])
  payments       Payment[]
  items          InvoiceItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, issuedAt])
  @@index([organizationId, jobId, status])
}

model SaleItem {
  id             String          @id @default(cuid())
  organizationId String
  kind           InvoiceItemKind
  name           String
  pricePaise     Int
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoiceItems   InvoiceItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, active])
}

model InvoiceItem {
  id             String          @id @default(cuid())
  organizationId String
  invoiceId      String
  position       Int             @default(0)
  saleItemId     String?
  kind           InvoiceItemKind
  description    String
  quantity       Int
  unitPricePaise Int
  subtotalPaise  Int
  taxRateBps     Int
  taxPaise       Int
  totalPaise     Int
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoice        Invoice         @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  saleItem       SaleItem?        @relation(fields: [saleItemId, organizationId], references: [id, organizationId])

  @@index([organizationId, invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  idempotencyKey String
  amountPaise    Int
  method         PaymentMethod
  reference      String?
  notes          String?
  collectedById  String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id])
  invoice        Invoice       @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  collectedBy    User          @relation(fields: [collectedById, organizationId], references: [id, organizationId])

  @@index([organizationId, invoiceId, createdAt])
  @@index([organizationId, createdAt])
  @@unique([organizationId, idempotencyKey])
}

model VehicleInspection {
  id             String       @id @default(cuid())
  organizationId String
  jobId          String       @unique
  recordedById   String
  finalizedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  job            Job          @relation(fields: [jobId, organizationId], references: [id, organizationId])
  recordedBy     User         @relation(fields: [recordedById, organizationId], references: [id, organizationId])
  damages        InspectionDamageItem[]

  @@unique([id, organizationId])
  @@unique([jobId, organizationId])
  @@index([organizationId, createdAt])
}

model InspectionDamageItem {
  id             String             @id @default(cuid())
  organizationId String
  inspectionId   String
  location       InspectionLocation
  type           DamageType
  description    String?
  organization   Organization       @relation(fields: [organizationId], references: [id])
  inspection     VehicleInspection  @relation(fields: [inspectionId, organizationId], references: [id, organizationId])
  photos         Photo[]

  @@unique([id, organizationId])
  @@index([organizationId, inspectionId])
}

model Photo {
  id             String                @id @default(cuid())
  organizationId String
  jobId          String
  damageItemId   String?
  kind           PhotoKind
  storageKey     String                @unique
  mimeType       String
  byteSize       Int
  description    String?
  customerVisible Boolean @default(false)
  uploadedById   String
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id])
  job            Job                   @relation(fields: [jobId, organizationId], references: [id, organizationId])
  damageItem     InspectionDamageItem? @relation(fields: [damageItemId, organizationId], references: [id, organizationId])
  uploadedBy     User                  @relation(fields: [uploadedById, organizationId], references: [id, organizationId])

  @@index([organizationId, jobId, createdAt])
}
