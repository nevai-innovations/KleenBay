# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Production values belong in your hosting provider's secret store.

# ---- Runtime ----
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Public origin of the web app. Used for Origin/CSRF checks. Must be https in production.
APP_ORIGIN=http://localhost:5173

# true in production (HTTPS only). Enables Secure + the __Host- cookie prefix.
# Defaults to true when NODE_ENV=production and false otherwise.
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs
# in rate limiting. Set to 1 only when API access is restricted to one trusted
# proxy/load balancer that appends the real client IP to X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Local uploads remain on disk. Production requires S3 with a private bucket.
# Supply AWS credentials through the workload identity/default SDK chain, never here.
STORAGE_PROVIDER=local
# S3_BUCKET=<private bucket name>
# S3_REGION=<bucket region>

# ---- Database ----
# These match docker-compose.yml and are for local development only.
DATABASE_URL=postgresql://carwash:carwash_dev_only@localhost:5432/carwash
# Must equal the database name in DATABASE_URL. Required when NODE_ENV=production.
# Shared RDS target: kleenbay for production, kleenbay_stage for staging.
EXPECTED_DATABASE_NAME=carwash
# Used by the test suite. The database name must end in _test (tests truncate every table).
# The test suite accepts only a loopback PostgreSQL host; never use shared RDS here.
TEST_DATABASE_URL=postgresql://carwash:carwash_dev_only@localhost:5432/carwash_test

# ---- Development seed only (refuses to run when NODE_ENV=production) ----
# Leave empty to generate a random password that is printed once.
DEV_SEED_PASSWORD=

# Local fixed OTP. Public stage uses its separate DUMMY_OTP mode and ConfigMap.
DEV_OTP_ENABLED=true
DEV_OTP_FIXED_CODE=123456

# OTP mode is selected at runtime. Stage: OTP_PROVIDER=DUMMY_OTP and
# DUMMY_OTP=123456 in the stage ConfigMap, with OTP_HASH_SECRET in a secret.
# The API also requires the kleenbay-stage namespace, staging mode, stage DB,
# and stage HTTPS origin. Production: OTP_PROVIDER=MSG91, with the following
# in a dedicated secret, not this file. The Widget ID/token are browser-public;
# AuthKey and hash secret must stay server-only.
OTP_PROVIDER=unconfigured
# DUMMY_OTP=123456  # stage ConfigMap only; never set in production
# OTP_HASH_SECRET=<random 32+ character secret>
# TRACKING_TOKEN_SECRET=<random 32+ character secret>  # optional local override; keep stable after jobs are created
# MSG91_AUTH_KEY=<KleenBay OTPWidget-scoped key>
# MSG91_WIDGET_ID=<KleenBay widget ID>
# MSG91_WIDGET_TOKEN=<KleenBay widget token>
# MSG91_WIDGET_OTP_LENGTH=6
# OTP_TTL_MINUTES=5
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# OTP_RATE_LIMIT_WINDOW_MINUTES=15
# OTP_MAX_REQUESTS_PER_PHONE_WINDOW=5
# OTP_MAX_REQUESTS_PER_SOURCE_WINDOW=12

# Local and stage customer updates are recorded and simulated; no external message is sent.
# Production requires msg91 and approved organization-specific WhatsApp senders/templates.
MESSAGING_PROVIDER=mock
MOCK_MESSAGING_FAIL=false
# MSG91_WHATSAPP_AUTH_KEYS_JSON={"<organizationId>:<credentialRef>":"<MSG91 AuthKey>"}
# Keep this JSON only in a secret. The organization sender and credentialRef are
# provisioned server-side; never expose this mapping to the browser.
# Tracking links use a stable local-only key unless TRACKING_TOKEN_SECRET is set.
# Public stage currently derives a separate tracking encryption key from its
# persistent OTP_HASH_SECRET; a dedicated secret can replace it later.
# Public tracking expires this many days after vehicle handover.
TRACKING_EXPIRY_DAYS=30

# Public staging only: keep NODE_ENV=production and DEV_OTP_ENABLED=false.
# DUMMY_OTP mode requires POD_NAMESPACE=kleenbay-stage (set by Kubernetes,
# not by this local file). Local photo storage needs a persistent volume.
STAGING_MODE=false

# ---- KleenBay subscription billing (optional locally; use PayU sandbox only in stage) ----
# Keep the merchant key/salt in environment secrets, never in a ConfigMap or browser build.
# Leave all three unset until a dedicated KleenBay PayU merchant account is ready.
# PAYU_MERCHANT_KEY=<KleenBay PayU merchant key>
# PAYU_MERCHANT_SALT=<KleenBay PayU merchant salt>
# PAYU_BASE_URL=https://test.payu.in
# Live PayU remains disabled until final policy copy is approved.
BILLING_POLICIES_APPROVED=false

# Session lifetime in hours. HTTPS cookies are required in production.
SESSION_HOURS=168
